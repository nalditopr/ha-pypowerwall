{
  "config": {
    "step": {
      "user": {
        "title": "Connect to PyPowerwall Proxy",
        "description": "Enter the host and port of your running pypowerwall proxy server.",
        "data": {
          "host": "Host",
          "port": "Port",
          "scan_interval": "Polling interval (seconds)",
          "control_secret": "Control secret (PW_CONTROL_SECRET)"
        }
      },
      "reconfigure": {
        "title": "Reconfigure PyPowerwall Proxy",
        "description": "Change the host, port, polling interval or control secret of this pypowerwall proxy.",
        "data": {
          "host": "Host",
          "port": "Port",
          "scan_interval": "Polling interval (seconds)",
          "control_secret": "Control secret (PW_CONTROL_SECRET)"
        }
      },
      "reauth_confirm": {
        "title": "Update control secret",
        "description": "The pypowerwall proxy at {host} rejected the control secret. Enter the current PW_CONTROL_SECRET (leave empty to disable controls).",
        "data": {
          "control_secret": "Control secret (PW_CONTROL_SECRET)"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot connect to the pypowerwall proxy. Verify the host/port and that the proxy is running.",
      "invalid_auth": "The proxy rejected the control secret. Check PW_CONTROL_SECRET on the proxy.",
      "control_unsupported": "This proxy does not have control mode enabled (PW_CONTROL_SECRET not set). Leave the control secret empty."
    },
    "abort": {
      "already_configured": "This pypowerwall proxy is already configured.",
      "reconfigure_successful": "Reconfiguration successful",
      "reauth_successful": "Control secret updated"
    }
  },
